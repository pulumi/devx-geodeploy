# Copy to .env and fill in what you need. .env is gitignored; never commit real values.

# TypeSafe Jev. Without it, GeoDeploy uses its deterministic fallback.
TYPESAFE_API_KEY=

# AWS (or set AWS_PROFILE instead of keys)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# AWS_PROFILE=

# Azure service principal
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Google Cloud: path to a service account key kept OUTSIDE this repo,
# plus an API key for the Cloud Billing Catalog
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_API_KEY=

# Pulumi Cloud
PULUMI_ACCESS_TOKEN=

# DNS (optional; set only the provider you use)
CLOUDFLARE_API_TOKEN=
NS1_APIKEY=

# Pricing cache location (optional)
# GEODEPLOY_PRICING_CACHE_DIR=
